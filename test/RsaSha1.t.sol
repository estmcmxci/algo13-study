pragma solidity ^0.8.26;
import "./Unified.t.sol";

/// RSASHA1 (algorithms 5 and 7) at the deployed verifier, on the SAME harness
/// and warm treatment as every other figure in the study.
///
/// Measured rather than assumed: the EVM has no SHA-1 precompile, so RSASHA1
/// computes its digest in Solidity and does not share algorithm 8 cost curve.
/// Vectors are real triples extracted from production calldata and verified
/// off-chain before use (research/scripts/f3-rsasha1-vectors.mjs).
contract RsaSha1 is Unified {
    address constant V57 = 0x58E0383E21f25DaB957F6664240445A514E9f5e8; // algorithms(5) and (7)
    bytes K0 = hex"";
    bytes D0 = hex"";
    bytes S0 = hex"";
    bytes K1 = hex"";
    bytes D1 = hex"";
    bytes S1 = hex"";

    function test_rsasha1Costs() public view {
        console.log("RSASHA1 GAS (warm, via Probe, deployed mainnet bytecode)");
        _report("rsasha1_alg5_2048", V57, K0, D0, S0);
        _report("rsasha1_alg7_2048", V57, K1, D1, S1);
    }
}
