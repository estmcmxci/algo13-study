pragma solidity ^0.8.26;
import "forge-std/Test.sol";
interface IAlg { function verify(bytes calldata k, bytes calldata d, bytes calldata s) external view returns (bool); }
contract Probe {
    function measure(address v, bytes calldata k, bytes calldata d, bytes calldata s)
        external view returns (uint256 g, bool ok) {
        uint256 a = gasleft(); ok = IAlg(v).verify(k, d, s); g = a - gasleft();
    }
}
/// RSASHA256 gas at the modulus sizes ACTUALLY PRESENT in ENS import proofs.
/// Vectors are real (key, data, signature) triples extracted from production
/// calldata and cryptographically verified before use.
contract RsaSizes is Test {
    address constant V8 = 0xaee0E2c4d5AB2fc164C8b0Cc8D3118C1c752C95E;
    Probe p;
    function setUp() public { p = new Probe(); }
    bytes K2048 = hex"";
    bytes D2048 = hex"";
    bytes S2048 = hex"";
    bytes K1280 = hex"";
    bytes D1280 = hex"";
    bytes S1280 = hex"";
    bytes K4096 = hex"";
    bytes D4096 = hex"";
    bytes S4096 = hex"";
    bytes K1024 = hex"0101030803010001b6747569f0c4a67618eddecaec6984b0be4f61d6f0a2bd04e6ea8b9dc23d7995d05fc19d68b2f491d4b4bdb02ceefc89f6b47f665c9082876dae02fc16b6dda58b41a24a75f59b5fcdce9eeb1801b03b99d6df34ad2c045b0d2ac982e9cbe4546e081f24f76286beeefb87491feefe99a588dbe0cfb0fbc1a24e88419ad94c05";
    bytes D1024 = hex"";
    bytes S1024 = hex"8801a4438948819eb0ee0f72fcaf94245a558c0c13951da68577c4ad8aeb89f8d8a40d494e75544a1f3adcaf9437598ea5706b52d86f29eb5fc2a0021742d7a4dc71bab29c2a4d90bdbb9d05269a4964eb900e15823411da4f56afbe892dbf53fb3fe6f853bd3dfb074dfff6972a9e00625211a6c80f04ea35ed2f95e02fe1cf";

    function test_rsaGasByModulusSize() public view {
        _one("1024", K1024, D1024, S1024);
        _one("1280", K1280, D1280, S1280);
        _one("2048", K2048, D2048, S2048);
        _one("4096", K4096, D4096, S4096);
    }
    function _one(string memory label, bytes memory k, bytes memory d, bytes memory s) internal view {
        (uint256 g1, bool ok) = p.measure(V8, k, d, s);
        (uint256 g2,) = p.measure(V8, k, d, s);
        (uint256 g3,) = p.measure(V8, k, d, s);
        console.log(label, g1, g2);
        console.log("   third run:", g3, ok ? 1 : 0);
        require(g2 == g3, "not deterministic");
    }
}
