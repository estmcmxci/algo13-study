# Any mainnet endpoint. A public one is fine for the Foundry tests, which fork at
# latest and only read deployed bytecode.
MAINNET_RPC_URL=https://eth.drpc.org

# The Node census scripts need the same endpoint under this name. Trace-method
# scripts (p1-census.mjs and friends) additionally need a provider that serves
# trace_* / debug_trace* — most free tiers do not. See README, tier 3.
MAINNET_API_KEY=https://eth.drpc.org
