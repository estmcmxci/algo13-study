# Default endpoint. This is the one the study itself used for trace methods, and the
# only public endpoint tested here that serves all three tiers.
#
# Tested 2026-07-29:
#   evm.stupidtech.net/v1/1       tiers 1-2 OK, trace_transaction OK
#   ethereum-rpc.publicnode.com   tiers 1-2 OK, no traces ("archive requests require a token")
#   eth.drpc.org                  fails tier 2 — HTTP 408 under Foundry's fork workload
#
# Any archive endpoint of your own will also work, and is preferable if you are
# running tier 3, which makes thousands of trace calls.

MAINNET_RPC_URL=https://evm.stupidtech.net/v1/1
MAINNET_API_KEY=https://evm.stupidtech.net/v1/1
